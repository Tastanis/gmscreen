# The other-NPC list, its saved copies and its lock. Only the site's own code reads them. Pages and scripts are not affected.
# Written the same way as the <Files> blocks in dnd/data/.htaccess, which this host accepts.
<Files *.json>
    Order deny,allow
    Deny from all
</Files>
<Files *.lock>
    Order deny,allow
    Deny from all
</Files>
