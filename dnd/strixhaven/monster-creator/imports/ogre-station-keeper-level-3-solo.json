    "passive": [
      {
        "name": "Solo Monster — End Effect",
        "effect": "At the end of each of her turns, the ogre can take 5 damage to end one effect on her that can be ended by a saving throw. This damage can't be reduced in any way.",
        "automation": {
          "schema": "ability-automation/v3",
          "cards": [
            {
              "type": "effect",
              "target": "self",
              "effects": [
                {
                  "kind": "ifPrompt",
                  "target": "self",
                  "question": "Take 5 irreducible damage to end one save-ends effect?",
                  "yesLabel": "Take 5 Damage",
                  "noLabel": "Cancel",
                  "then": [
                    {
                      "kind": "damage",
                      "target": "self",
                      "amount": 5,
                      "raw": true
                    },
                    {
                      "kind": "note",
                      "text": "Remove one effect on the ogre that can be ended by a saving throw."
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "name": "Solo Monster — Solo Turns",
        "effect": "The ogre takes two turns each round. She can't take turns consecutively."
      },
      {
        "name": "Destructive Path",
        "effect": "When the ogre moves or is force moved, she can destroy mundane size 1 objects in her path and break through mundane wood or stone walls up to 2 squares thick. Broken wall squares become difficult terrain."
      },
      {
        "name": "Defiant Anger",
        "effect": "While winded, the ogre has damage immunity 2.",
