# No visitor may download the database, its side files or its dated copies, the scene list, the token list or the old board file.
# Only the site's own code reads them. Pictures in uploads/ and tokens/ are not affected.
# Written the same way as the <Files> blocks in dnd/data/.htaccess, which this host accepts.
<Files *.sqlite*>
    Order deny,allow
    Deny from all
</Files>
<Files scenes.json>
    Order deny,allow
    Deny from all
</Files>
<Files tokens.json>
    Order deny,allow
    Deny from all
</Files>
<Files board-state.json>
    Order deny,allow
    Deny from all
</Files>
